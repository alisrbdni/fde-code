# Copy to .env (never commit .env). Everything is optional for local mode:
# with no TELNYX_API_KEY the API runs offline (fake Telnyx API, stub chat model,
# in-memory KV and storage). The console's Settings tab can override most of these
# in memory at runtime (ADMIN_TOKEN excepted).

# --- Telnyx ---------------------------------------------------------------
TELNYX_API_KEY=
# true = build agents in memory only, even with a key (inference still uses the key)
FORGE_DRY_RUN=
TELNYX_API_BASE=https://api.telnyx.com/v2

# --- tokens -----------------------------------------------------------------
# Bearer token the assistants send to the webhook tools and MCP servers
MCP_TOKEN=
# Protects /ui/api/* and /ops/metrics|flags|builder (empty = open, local only)
ADMIN_TOKEN=
# Shared by forge-api and forge-state for /rpc and the alarm's /internal/jobs
STATE_TOKEN=dev-token

# --- edge wiring ------------------------------------------------------------
# Public URL of forge-api (webhooks and generated agents point back here)
API_URL=http://localhost:8080
# forge-state RPC base URL (empty = actors emulated in-process)
STATE_URL=
# Telnyx KV namespace (empty = in-memory KV)
KV_NAMESPACE_ID=

# --- outbound test calls ------------------------------------------------------
TEXML_APP_ID=
FORGE_NUMBER=

# --- models ---------------------------------------------------------------------
ASSISTANT_MODEL=moonshotai/Kimi-K3
POLISH_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# console chat model (defaults to ASSISTANT_MODEL; must support tool calling)
CHAT_MODEL=

# --- Telnyx Cloud Storage (S3-compatible; empty endpoint = in-memory) -------------
STORAGE_ENDPOINT=
STORAGE_BUCKET=agent-forge
STORAGE_REGION=us-central-1
# defaults to TELNYX_API_KEY
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=telnyx

# --- clinic (Clara) ----------------------------------------------------------------
# Clara's assistant id: enables Forge's handoff tool
CLINIC_ASSISTANT_ID=
CLINIC_FRONT_DESK_NUMBER=
CLINIC_UTC_OFFSET=-05:00

# --- webhook signatures (needs `pip install cryptography` on the function) ----------
VERIFY_SIGNATURES=false
TELNYX_PUBLIC_KEY=
LOG_LEVEL=info
